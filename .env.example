# ------------------------------------------------------------------ analyzer
# Which model backend analyzes photos. Default: anthropic.
#   anthropic          — Claude API (best results). Needs ANTHROPIC_API_KEY.
#   openai-compatible  — any /v1/chat/completions endpoint: Ollama, LM Studio,
#                        vLLM, OpenRouter. Use this to run fully local with a
#                        vision-capable model (e.g. a Hermes or Llama vision
#                        build served by Ollama).
ANALYZER=anthropic

# For ANALYZER=anthropic. Never expose this key to the browser — the server
# proxies one API call per photo.
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default claude-opus-4-8)
#ANTHROPIC_MODEL=claude-opus-4-8

# For ANALYZER=openai-compatible
#OPENAI_BASE_URL=http://localhost:11434/v1
#OPENAI_MODEL=llama3.2-vision
#OPENAI_API_KEY=            # optional; Ollama/LM Studio ignore it

# Set to 1 to run without any model backend (returns a canned analysis).
MOCK_ANALYZE=0

# ------------------------------------------------------------------ market data
# Ground the value estimate in real reseller data. Default: none.
#   ebay  — eBay Browse API: live comparable listings + asking-price stats.
#           Free developer keys: https://developer.ebay.com
#   keepa — Keepa (Amazon price data resellers use): https://keepa.com/#!api
PRICING=none
#EBAY_CLIENT_ID=
#EBAY_CLIENT_SECRET=
#KEEPA_API_KEY=

# ------------------------------------------------------------------ interfaces
# Web server port
PORT=3000

# Telegram bot (npm run telegram) — long polling, no public URL needed.
# Create a bot with @BotFather.
#TELEGRAM_BOT_TOKEN=
